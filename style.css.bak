/* ============================================================
CogniHoney™ — SlimTide structure, Steel-Teal #438190 + Honey accent
============================================================ */
*{margin:0;padding:0;box-sizing:border-box}
:root{
--teal:#438190;
--teal-deep:#2C5661;
--teal-soft:#8FBAC4;
--honey:#E9A83A;
--ink:#10222A;
--ink-2:#16303A;
--cream:#F6FAFB;
--cream-2:#E3F0F2;
--text:#122A32;
--body:#4E626B;
--muted:#7C9099;
--line:rgba(16,34,42,.09);
--grad:linear-gradient(135deg,#438190 0%,#6FA5B1 100%);
--grad-deep:linear-gradient(135deg,#2C5661 0%,#438190 100%);
--grad-dark:linear-gradient(160deg,#10222A 0%,#2C5661 100%);
--shadow-sm:0 2px 10px rgba(16,34,42,.06);
--shadow:0 8px 30px rgba(67,129,144,.12);
--shadow-lg:0 24px 60px rgba(67,129,144,.20);
--radius:18px;--radius-sm:12px;--radius-pill:999px;
--transition:all .28s ease;
}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:'Inter',system-ui,sans-serif;color:var(--body);background:var(--cream);line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,h5,h6{font-family:'Poppins',sans-serif;color:var(--text);line-height:1.25;font-weight:700}
a{text-decoration:none;color:inherit;transition:var(--transition)}
img,svg{max-width:100%;height:auto;display:block}
.container{max-width:1180px;margin:0 auto;padding:0 1.4rem}
section{padding:5rem 0}
ul{list-style:none}
.eyebrow{display:inline-block;font-size:1.09rem;font-weight:700;text-transform:uppercase;letter-spacing:.16em;color:var(--teal);margin-bottom:.7rem}
.section-head{max-width:820px;margin:0 auto 3rem;text-align:center}
.section-title{font-size:clamp(1.7rem,3.4vw,2.5rem);margin-bottom:1rem;letter-spacing:-.01em}
.section-desc{font-size:1.05rem;color:var(--body)}
.bg-cream{background:var(--cream)}
.text-center{text-align:center}
/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:'Poppins',sans-serif;font-weight:700;font-size:1rem;padding:.95rem 2rem;border-radius:var(--radius-pill);border:none;cursor:pointer;transition:var(--transition);text-align:center;line-height:1.2}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 10px 26px rgba(67,129,144,.35)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(67,129,144,.45)}
.btn-outline{background:#fff;color:var(--teal-deep);border:1.5px solid var(--cream-2)}
.btn-outline:hover{border-color:var(--teal);transform:translateY(-2px)}
.btn-lg{padding:1.15rem 2.6rem;font-size:1.08rem}
.btn-block{display:flex;width:100%}
/* Reviewer bar */
.review-bar{background:var(--ink);color:rgba(255,255,255,.82);font-size:.8rem;padding:.5rem 1rem;text-align:center}
.review-bar span{margin:0 .55rem;white-space:nowrap;display:inline-block}
.review-bar strong{color:#fff;font-weight:600}
.review-bar .chk{color:var(--honey)}
/* Nav */
nav{position:sticky;top:0;width:100%;z-index:1000;background:rgba(246,250,251,.93);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);padding:.7rem 0;transition:var(--transition)}
nav.scrolled{box-shadow:0 6px 24px rgba(16,34,42,.08)}
.nav-inner{max-width:1180px;margin:0 auto;padding:0 1.4rem;display:flex;align-items:center;justify-content:space-between}
.logo{font-family:'Poppins',sans-serif;font-size:1.55rem;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.logo span{color:var(--teal)}
.nav-links{display:flex;gap:1.5rem;align-items:center}
.nav-links a{font-size:.9rem;font-weight:500;color:var(--body)}
.nav-links a:hover{color:var(--teal)}
.nav-cta{background:var(--grad);color:#fff!important;padding:.6rem 1.4rem;border-radius:var(--radius-pill);font-weight:700;box-shadow:0 6px 16px rgba(67,129,144,.3)}
.nav-cta:hover{transform:translateY(-2px)}
.mobile-toggle{display:none;background:none;border:none;font-size:1.6rem;color:var(--ink);cursor:pointer}
/* Hero */
.hero{position:relative;background:radial-gradient(1200px 500px at 80% -10%,rgba(67,129,144,.16),transparent),var(--cream);padding:3.5rem 0 4.5rem;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center}
.hero-badge{display:inline-flex;align-items:center;gap:.5rem;background:#fff;border:1px solid var(--cream-2);color:var(--teal-deep);font-weight:600;font-size:.82rem;padding:.45rem 1rem;border-radius:var(--radius-pill);box-shadow:var(--shadow-sm);margin-bottom:1.3rem}
.hero h1{font-size:clamp(2rem,4.6vw,3.2rem);letter-spacing:-.02em;margin-bottom:1.1rem}
.hero h1 span{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.hero-intro{font-size:1.08rem;color:var(--body);margin-bottom:1.6rem;max-width:600px}
.hero-intro strong{color:var(--text)}
.quick-facts{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.3rem 1.5rem;box-shadow:var(--shadow);margin-bottom:1.6rem}
.quick-facts h4{font-size:.78rem;text-transform:uppercase;letter-spacing:.14em;color:var(--teal);margin-bottom:.9rem}
.qf-item{display:flex;gap:.6rem;padding:.45rem 0;border-bottom:1px dashed var(--line);font-size:.92rem}
.qf-item:last-child{border-bottom:none}
.qf-item b{color:var(--text);min-width:120px;font-weight:600;font-family:'Poppins',sans-serif}
.hero-bullets{margin-bottom:1.7rem}
.hero-bullets li{position:relative;padding-left:1.9rem;margin-bottom:.6rem;color:var(--body)}
.hero-bullets li::before{content:"✓";position:absolute;left:0;top:0;width:1.3rem;height:1.3rem;background:var(--grad);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700}
.hero-stats{display:flex;gap:1.8rem;margin-bottom:1.8rem;flex-wrap:wrap}
.stat{text-align:left}
.stat .num{font-family:'Poppins',sans-serif;font-size:1.9rem;font-weight:800;color:var(--teal-deep);line-height:1}
.stat .lbl{font-size:.82rem;color:var(--muted);margin-top:.25rem}
.hero-ctas{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.7rem}
.hero-trust{display:flex;gap:1.4rem;flex-wrap:wrap;font-size:.85rem;color:var(--muted);font-weight:500}
.hero-trust span{display:inline-flex;align-items:center;gap:.4rem}
.hero-trust span::before{content:"●";color:var(--teal);font-size:.6rem}
.hero-media{position:relative;text-align:center;top:-270px}
.hero-media .product-img{max-height:720px;width:800px;margin:0 auto;filter:drop-shadow(0 30px 50px rgba(16,34,42,.28))}
.float-badge{position:absolute;background:#fff;border-radius:14px;padding:.6rem .9rem;box-shadow:var(--shadow-lg);font-size:.8rem;font-weight:600;color:var(--text);font-family:'Poppins',sans-serif;display:flex;flex-direction:column;line-height:1.2}
.float-badge b{color:var(--teal);font-size:1.05rem}
.fb-1{top:12%;left:-4%}
.fb-2{top:46%;right:-6%}
.fb-3{bottom:8%;left:2%}
/* Why */
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
.why-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.8rem 1.4rem;text-align:center;transition:var(--transition)}
.why-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:transparent}
.why-icon{width:62px;height:62px;border-radius:16px;background:var(--cream-2);display:flex;align-items:center;justify-content:center;font-size:1.75rem;margin:0 auto 1.1rem}
.why-card h4{font-size:1.02rem;margin-bottom:.6rem;text-transform:uppercase;letter-spacing:.02em}
.why-card p{font-size:.9rem;color:var(--muted)}
/* What is */
.whatis-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:3rem;align-items:center}
.whatis-media{text-align:center}
.whatis-media .whatis-img{max-height:440px;margin:0 auto;filter:drop-shadow(0 24px 44px rgba(16,34,42,.22))}
.whatis-text p{margin-bottom:1.05rem;color:var(--body)}
.research-support{background:var(--cream);border-left:4px solid var(--teal);border-radius:0 var(--radius-sm) var(--radius-sm) 0;padding:1.1rem 1.3rem;font-size:.92rem;margin:1.4rem 0}
.research-support a{color:var(--teal-deep);font-weight:600;text-decoration:underline}
.trust-chips{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.4rem 0}
.chip{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius-pill);padding:.4rem 1rem;font-size:.82rem;font-weight:600;color:var(--teal-deep)}
/* VS table */
.vs-wrap{overflow-x:auto}
.vs-table{width:100%;border-collapse:collapse;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm)}
.vs-table th,.vs-table td{padding:.85rem 1rem;border-bottom:1px solid var(--line);font-size:.9rem;text-align:center}
.vs-table th{background:var(--grad-dark);color:#fff;font-family:'Poppins',sans-serif}
.vs-table td:first-child,.vs-table th:first-child{text-align:left}
.vs-table td.yes{color:var(--teal-deep);font-weight:800}
.vs-table td.no{color:#b3a9a0}
.vs-table tr:last-child td{border-bottom:none}
/* How */
.how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-bottom:2.2rem}
.mech-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.7rem 1.5rem;transition:var(--transition)}
.mech-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.mech-icon{width:48px;height:48px;border-radius:12px;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:1rem}
.mech-card h4{font-size:1.08rem;margin-bottom:.55rem}
.mech-card p{font-size:.92rem;color:var(--muted)}
.how-summary{background:var(--grad-dark);color:rgba(255,255,255,.85);border-radius:var(--radius);padding:2rem 2.2rem;text-align:center;max-width:900px;margin:0 auto}
.how-summary h4{color:#fff;margin-bottom:.7rem;font-size:1.2rem}
/* Ingredients */
.ing-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1.4rem;margin-bottom:2.4rem}
.ing-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.7rem;position:relative;transition:var(--transition);overflow:hidden}
.ing-card:hover{box-shadow:var(--shadow);transform:translateY(-4px)}
.ing-num{position:absolute;top:1.1rem;right:1.3rem;font-family:'Poppins',sans-serif;font-size:2.6rem;font-weight:800;color:var(--cream-2);line-height:1}
.ing-card h4{font-size:1.16rem;margin-bottom:.7rem;padding-right:2.5rem}
.ing-card p{font-size:.92rem;color:var(--muted);margin-bottom:.7rem}
.ing-link{font-size:.86rem;font-weight:600;color:var(--teal);text-decoration:none}
.ing-link:hover{text-decoration:underline}
.ing-link::after{content:" →"}
.ing-conclusion{max-width:900px;margin:0 auto;text-align:center;color:var(--body);background:var(--cream);border-radius:var(--radius);padding:1.8rem 2rem}
/* Benefits */
.ben-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-bottom:2.4rem}
.ben-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.7rem;border-top:4px solid var(--teal);transition:var(--transition)}
.ben-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.ben-card h4{font-size:1.08rem;margin-bottom:.55rem}
.ben-card p{font-size:.92rem;color:var(--muted)}
/* Bonuses */
.bonus-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}
.bonus-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.8rem;transition:var(--transition)}
.bonus-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.bonus-ic{font-size:1.8rem;margin-bottom:.6rem}
.bonus-card h3{font-size:1.05rem;margin-bottom:.5rem}
.bonus-card p{font-size:.92rem;color:var(--muted);margin-bottom:.8rem}
.bonus-value{font-size:.82rem;font-weight:700;color:var(--teal-deep)}
/* Reviews */
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;margin-bottom:2.6rem}
.review-card{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:1.8rem;box-shadow:var(--shadow-sm)}
.review-card .rc-head{display:flex;align-items:center;gap:.9rem;margin-bottom:.9rem}
.review-card img{width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0}
.review-card .rc-name{font-family:'Poppins',sans-serif;font-weight:600;color:var(--text);font-size:.98rem}
.review-card .rc-loc{font-size:.8rem;color:var(--muted)}
.stars{color:var(--honey);font-size:.95rem;letter-spacing:1px;margin-bottom:.6rem}
.review-card blockquote{font-size:.93rem;color:var(--body);font-style:italic;border:none}
.review-stats{display:flex;justify-content:center;gap:3rem;flex-wrap:wrap;margin-bottom:2.2rem}
.review-stats .num{font-family:'Poppins',sans-serif;font-size:2.2rem;font-weight:800;color:var(--teal-deep);line-height:1}
.review-stats .lbl{font-size:.85rem;color:var(--muted);margin-top:.3rem}
.review-cta{text-align:center;max-width:760px;margin:0 auto}
.review-cta h3{color:var(--text);font-size:1.5rem;margin-bottom:.9rem}
.review-cta p{margin-bottom:1.6rem}
/* Pricing */
.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;align-items:stretch}
.price-card{background:#fff;border:2px solid var(--cream-2);border-radius:var(--radius);padding:2rem 1.6rem;text-align:center;position:relative;transition:var(--transition);display:flex;flex-direction:column}
.price-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.price-card.featured{border-color:var(--teal);box-shadow:var(--shadow-lg);transform:scale(1.03)}
.price-card.featured:hover{transform:scale(1.03) translateY(-6px)}
.price-badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--grad);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.4rem 1.1rem;border-radius:var(--radius-pill);white-space:nowrap}
.price-card h3{font-size:1.35rem;margin-bottom:.2rem}
.price-card .supply{font-size:.8rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem}
.price-img{height:170px;width:auto;margin:0 auto 1rem}
.price-amount{font-family:'Poppins',sans-serif;font-size:2.4rem;font-weight:800;color:var(--teal-deep);line-height:1}
.price-amount small{font-size:.95rem;color:var(--muted);font-weight:500}
.price-total{font-size:.9rem;color:var(--muted);margin:.6rem 0 1.2rem}
.price-total s{color:#a9bcc3}
.price-total b{color:var(--text)}
.price-card .buy-btn{margin-top:auto}
/* Guarantee */
.guarantee{display:grid;grid-template-columns:.7fr 1.3fr;gap:2.4rem;align-items:center;background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:2.2rem;box-shadow:var(--shadow)}
.guarantee-img .seal-img{max-height:210px;margin:0 auto}
.guarantee h3{font-size:1.5rem;margin-bottom:1.1rem}
.guarantee-points{display:grid;gap:1rem}
.guarantee-points li{padding-left:1.6rem;position:relative;font-size:.94rem;color:var(--body)}
.guarantee-points li::before{content:"✓";position:absolute;left:0;color:var(--teal);font-weight:700}
.guarantee-points b{color:var(--text);font-family:'Poppins',sans-serif}
/* FAQ */
.faq-wrap{max-width:840px;margin:0 auto}
.faq-item{background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius-sm);margin-bottom:.9rem;overflow:hidden}
.faq-q{padding:1.15rem 1.4rem;font-family:'Poppins',sans-serif;font-weight:600;color:var(--text);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:1rem;font-size:1rem}
.faq-q::after{content:"+";font-size:1.5rem;color:var(--teal);transition:var(--transition);flex-shrink:0}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;padding:0 1.4rem}
.faq-item.open .faq-a{max-height:400px;padding:0 1.4rem 1.2rem}
.faq-a p{font-size:.93rem;color:var(--body)}
/* References */
.ref-list{max-width:900px;margin:0 auto;columns:2;column-gap:2.5rem}
.ref-list li{font-size:.84rem;margin-bottom:.6rem;break-inside:avoid;color:var(--muted)}
.ref-list a{color:var(--teal-deep);word-break:break-word}
.ref-list a:hover{text-decoration:underline}
/* Security */
.security-box{max-width:880px;margin:0 auto;background:#fff;border:1px solid var(--cream-2);border-radius:var(--radius);padding:2rem 2.2rem}
.security-box h3{font-size:1.25rem;margin:1.3rem 0 .6rem}
.security-box h3:first-child{margin-top:0}
.security-box p{font-size:.93rem;color:var(--body);margin-bottom:.8rem}
/* Final CTA */
.final-cta{background:var(--grad-dark)}
.final-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:2.6rem;align-items:center;max-width:1000px;margin:0 auto}
.final-grid .final-bottle{max-height:300px;margin:0 auto;filter:drop-shadow(0 24px 44px rgba(0,0,0,.4))}
.final-text h2{color:#fff;font-size:clamp(1.7rem,3.6vw,2.4rem);margin-bottom:1.1rem}
.final-badges{display:flex;gap:1.4rem;flex-wrap:wrap;margin-bottom:1.4rem}
.final-badges .fb{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:.8rem 1.1rem;text-align:center}
.final-badges .fb b{display:block;font-family:'Poppins',sans-serif;font-size:1.3rem;color:var(--honey)}
.final-badges .fb span{font-size:.74rem;color:rgba(255,255,255,.7)}
.final-price{margin-bottom:1.5rem}
.final-price .reg{color:rgba(255,255,255,.55);text-decoration:line-through;font-size:1rem}
.final-price .now{font-family:'Poppins',sans-serif;font-size:1.5rem;font-weight:700;color:#fff;margin-left:.6rem}
/* Footer */
footer{background:var(--ink);color:rgba(255,255,255,.66);padding:3.4rem 0 1.6rem;font-size:.9rem}
.footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:2.4rem;padding-bottom:2.2rem;border-bottom:1px solid rgba(255,255,255,.12)}
.footer-col h4{color:#fff;font-size:1rem;margin-bottom:1rem}
.footer-col p,.footer-col li{margin-bottom:.55rem;line-height:1.6}
.footer-col a{color:rgba(255,255,255,.66)}
.footer-col a:hover{color:var(--teal-soft)}
.footer-col strong{color:#fff}
.footer-badges{display:flex;flex-wrap:wrap;gap:.5rem;padding:1.6rem 0;border-bottom:1px solid rgba(255,255,255,.12)}
.footer-badge{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--radius-pill);padding:.35rem .9rem;font-size:.76rem;color:rgba(255,255,255,.75)}
.footer-disclaimer{padding:1.6rem 0;font-size:.78rem;color:rgba(255,255,255,.45);line-height:1.7}
.footer-disclaimer p{margin-bottom:.8rem}
.copyright{text-align:center;font-size:.8rem;color:rgba(255,255,255,.4);margin-top:1rem}
/* Sticky bar */
.sticky-bar{position:fixed;bottom:0;left:0;width:100%;background:var(--grad-deep);color:#fff;z-index:1100;padding:.7rem 1.2rem;display:flex;align-items:center;justify-content:center;gap:1.2rem;box-shadow:0 -6px 24px rgba(16,34,42,.3);flex-wrap:wrap}
.sticky-bar-text{font-weight:600;font-family:'Poppins',sans-serif;font-size:.95rem}
.sticky-bar-text small{display:block;font-weight:400;font-size:.78rem;color:rgba(255,255,255,.8)}
.sticky-bar .btn{padding:.6rem 1.5rem;background:#fff;color:var(--teal-deep);font-size:.9rem}
.sticky-bar .btn:hover{transform:translateY(-2px)}
/* Back to top */
#back-to-top{position:fixed;bottom:5.5rem;right:1.4rem;width:46px;height:46px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1.2rem;opacity:0;pointer-events:none;transition:opacity .3s;box-shadow:0 6px 18px rgba(67,129,144,.4);z-index:1090;border:none}
#back-to-top.show{opacity:1;pointer-events:auto}
/* Legal pages */
.legal-hero{background:var(--grad-dark);color:#fff;padding:3.4rem 0 2.6rem}
.legal-hero h1{color:#fff;font-size:clamp(1.9rem,3.8vw,2.7rem);max-width:880px;margin:.6rem 0}
.legal-hero .meta{color:rgba(255,255,255,.65);font-size:.88rem}
.legal-content{max-width:780px;margin:3rem auto;padding:0 1.4rem}
.legal-content h2{font-size:1.7rem;margin:2.2rem 0 1rem}
.legal-content h3{font-size:1.3rem;margin:1.8rem 0 .8rem;color:var(--teal-deep)}
.legal-content p{margin-bottom:1.2rem;color:var(--body)}
.legal-content ul{margin:0 0 1.2rem 1.4rem}
.legal-content li{margin-bottom:.6rem;color:var(--body)}
.legal-content ul li{list-style:disc}
/* Responsive */
@media(max-width:992px){
.hero-grid{grid-template-columns:1fr;gap:2.4rem}
.hero-media{order:-1}
.hero-media .product-img{max-height:380px}
.whatis-grid{grid-template-columns:1fr;gap:2rem}
.whatis-media{order:-1}
.why-grid{grid-template-columns:repeat(2,1fr)}
.how-grid{grid-template-columns:repeat(2,1fr)}
.review-grid{grid-template-columns:1fr;max-width:480px;margin-left:auto;margin-right:auto}
.price-grid{grid-template-columns:1fr;max-width:420px;margin:0 auto}
.price-card.featured{transform:scale(1)}
.price-card.featured:hover{transform:translateY(-6px)}
.ing-list{grid-template-columns:1fr}
.bonus-grid{grid-template-columns:1fr}
.guarantee{grid-template-columns:1fr;text-align:center;gap:1.6rem}
.ben-grid{grid-template-columns:repeat(2,1fr)}
.final-grid{grid-template-columns:1fr;text-align:center;gap:1.8rem}
.final-grid .final-bottle{order:-1}
.final-badges{justify-content:center}
.footer-top{grid-template-columns:1fr 1fr}
.nav-links{position:fixed;top:0;right:-100%;height:100vh;width:80%;max-width:320px;background:var(--cream);flex-direction:column;align-items:flex-start;padding:5rem 2rem 2rem;gap:1.3rem;box-shadow:-10px 0 40px rgba(16,34,42,.15);transition:right .35s ease;overflow-y:auto}
.nav-links.active{right:0}
.nav-links a{font-size:1rem;width:100%}
.mobile-toggle{display:block;z-index:1001}
.ref-list{columns:1}
}
@media(max-width:640px){
section{padding:3.4rem 0}
.review-bar{font-size:.72rem}
.review-bar span:nth-child(n+3){display:none}
.hero{padding:2.4rem 0 3rem}
.hero-stats{gap:1.2rem}
.stat .num{font-size:1.6rem}
.why-grid,.how-grid,.ben-grid{grid-template-columns:1fr}
.float-badge{display:none}
.hero-ctas .btn{width:100%}
.review-stats{gap:1.6rem}
.footer-top{grid-template-columns:1fr;gap:1.8rem}
.guarantee,.security-box,.how-summary,.ing-conclusion{padding:1.5rem}
.sticky-bar{gap:.7rem;padding:.6rem .9rem}
.sticky-bar-text{font-size:.85rem}
.sticky-bar-text small{display:none}
#back-to-top{bottom:4.8rem}
}
.price-img.small{
  max-height:200px;   /* was ~170px */
  max-width:auto;
  width:auto;
  margin:0 auto 1rem;
  object-fit:contain;
}